{
  "name": "celine-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "predev": "npm run tokens",
    "dev": "next dev",
    "prebuild": "npm run tokens",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typegen": "sanity schema extract --force --path=src/sanity/extract.json && sanity typegen generate",
    "seed:build": "sanity exec scripts/seed.ts",
    "seed:import": "npm run seed:build && sanity dataset import seed/production.ndjson production --missing"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@sanity/icons": "^5.4.0",
    "@sanity/ui": "^4.4.12",
    "@sanity/vision": "^6.24.0",
    "gsap": "^3.15.1",
    "next": "16.4.6",
    "next-intl": "^4.16.0",
    "next-sanity": "^13.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanity": "^6.24.0",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
