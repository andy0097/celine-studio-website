# Copy to .env.local and fill in. Also set these on Vercel.

# Sanity (public ids; defaults in src/sanity/env.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=abej04l7
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: live content + drafts in the live preview (sanity.io/manage → API → Tokens)
SANITY_API_READ_TOKEN=
# Secret of the publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Leads (booking form) — Supabase project → Settings → API
SUPABASE_URL=
# Service-role key: server only, never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Email to the studio on each new lead — resend.com → API Keys
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Celine Studio <site@celinestudio.ro>"
LEADS_FROM_EMAIL=
# Who gets the email (defaults to the contact email in Sanity's Site settings)
LEADS_NOTIFY_EMAIL=

# Admin API: Sanity roles allowed to use the admin tools (default administrator,editor)
ADMIN_ROLES=

# Production origin for canonical/hreflang URLs
NEXT_PUBLIC_SITE_URL=https://celinestudio.ro

# Admin Agent (/admin → Agent): chat that edits Sanity drafts and opens GitHub PRs. Never publishes or merges.
# Anthropic API key — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Fine-grained GitHub token for this repo only: Contents, Pull requests, Issues = Read and write
AGENT_GITHUB_TOKEN=
# Sanity Editor token (drafts only are written) — sanity.io/manage → API → Tokens
SANITY_API_WRITE_TOKEN=
# Monthly spending cap in USD (usage logged in Supabase table agent_runs; needs SUPABASE_* above)
AGENT_MONTHLY_BUDGET_USD=20
# Optional: AGENT_MODEL (default claude-opus-5-5), AGENT_GITHUB_REPO, AGENT_GITHUB_REVIEWER, AGENT_MAX_COST_PER_REQUEST_USD
