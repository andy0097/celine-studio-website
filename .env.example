# Copy to .env.local and fill in. Also set these on Vercel.

# Sanity (public ids; defaults in src/sanity/env.ts)
NEXT_PUBLIC_SANITY_PROJECT_ID=abej04l7
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token: live content + drafts in the live preview (sanity.io/manage → API → Tokens)
SANITY_API_READ_TOKEN=
# Secret of the publish webhook that calls /api/revalidate
SANITY_REVALIDATE_SECRET=

# Leads (booking form) — Supabase project → Settings → API
SUPABASE_URL=
# Service-role key: server only, never expose it to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Email to the studio on each new lead — resend.com → API Keys
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Celine Studio <site@celinestudio.ro>"
LEADS_FROM_EMAIL=
# Who gets the email (defaults to the contact email in Sanity's Site settings)
LEADS_NOTIFY_EMAIL=

# Admin API: Sanity roles allowed to use the admin tools (default administrator,editor)
ADMIN_ROLES=

# Drawing generator (admin). Chosen model: Gemini (aistudio.google.com → Get API key, billing on).
# The other two keys are optional alternatives; the tool lets you pick per run.
GEMINI_API_KEY=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
# Optional: which one is selected by default (gemini | replicate | openai), model overrides
DRAWING_PROVIDER=
GEMINI_IMAGE_MODEL=
REPLICATE_IMAGE_MODEL=
OPENAI_IMAGE_MODEL=
# Drawings per calendar month across all admins (default 50; 0 switches the generator off)
DRAWING_MONTHLY_CAP=50
# Optional: replaces the built-in style instructions (src/lib/drawing/prompt.ts) while tuning
DRAWING_STYLE_PROMPT=
# Optional Sanity Editor token for the usage counter and saving generated files;
# without it the signed-in admin's own Studio token is used
SANITY_API_WRITE_TOKEN=

# Production origin for canonical/hreflang URLs
NEXT_PUBLIC_SITE_URL=https://celinestudio.ro

# Analytics (decision 0.8: GA4 + Microsoft Clarity). Both load only after the
# visitor accepts the cookie banner; leave empty to show no banner at all.
# GA4 → Admin → Data streams → Web → Measurement ID (G-…)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# clarity.microsoft.com → project → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Admin Analytics screen reads GA4 through the Data API with a service account:
# Google Cloud → enable "Google Analytics Data API" → Service account → Keys → JSON;
# then GA4 → Admin → Property access management → add its email as Viewer.
# Property ID: GA4 → Admin → Property details (numbers only)
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
# The JSON key's "private_key", on one line with \n (keep the quotes)
GA4_PRIVATE_KEY=
# Admin Agent (/admin → Agent): chat that edits Sanity drafts and opens GitHub PRs. Never publishes or merges.
# Anthropic API key — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Fine-grained GitHub token for this repo only: Contents, Pull requests, Issues = Read and write
AGENT_GITHUB_TOKEN=
# Uses SANITY_API_WRITE_TOKEN above (Sanity Editor token; the agent writes drafts only)
# Monthly spending cap in USD (usage logged in Supabase table agent_runs; needs SUPABASE_* above)
AGENT_MONTHLY_BUDGET_USD=20
# Optional: AGENT_MODEL (default claude-opus-5-5), AGENT_GITHUB_REPO, AGENT_GITHUB_REVIEWER, AGENT_MAX_COST_PER_REQUEST_USD
